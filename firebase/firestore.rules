rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Perfil de usuario (specs 002 y 004): solo su dueño puede leerlo y escribirlo.
    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      function unchanged(field) {
        return request.resource.data.get(field, null) == resource.data.get(field, null);
      }

      // Campo opcional: ausente, nulo o un texto de como máximo maxSize caracteres.
      function optionalString(field, maxSize) {
        let value = request.resource.data.get(field, null);
        return value == null || (value is string && value.size() <= maxSize);
      }

      allow read: if isOwner();
      allow create: if isOwner()
                    && request.resource.data.uid == uid;
      allow update: if isOwner()
                    && request.resource.data.keys().hasOnly([
                         'uid', 'name', 'email', 'photoUrl', 'provider', 'createdAt',
                         'phone', 'address', 'birthDate', 'updatedAt'])
                    && unchanged('uid')
                    && unchanged('createdAt')
                    && unchanged('provider')
                    // El correo es una copia del de Auth: solo puede pasar a ser el de la sesión.
                    && (unchanged('email') || request.resource.data.email == request.auth.token.email)
                    && (unchanged('name') || (request.resource.data.name is string
                                              && request.resource.data.name.size() >= 2
                                              && request.resource.data.name.size() <= 50))
                    && optionalString('phone', 20)
                    && optionalString('address', 100)
                    && optionalString('photoUrl', 2048)
                    && (request.resource.data.get('birthDate', null) == null
                        || (request.resource.data.birthDate is string
                            && request.resource.data.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
                    && (unchanged('updatedAt') || request.resource.data.updatedAt == request.time);
      // Solo la Cloud Function deleteAccount (Admin SDK) borra perfiles (spec 004).
      allow delete: if false;

      // Mascotas (spec 005): solo el dueño. deleteAccount las borra junto con el perfil.
      match /pets/{petId} {
        function textBetween(field, minSize, maxSize) {
          let value = request.resource.data.get(field, null);
          return value is string && value.trim().size() >= minSize && value.size() <= maxSize;
        }

        function isValidPet() {
          let data = request.resource.data;
          return data.keys().hasOnly([
                   'name', 'species', 'breed', 'birthDate', 'sex', 'weightKg',
                   'photoUrl', 'createdAt', 'updatedAt'])
                 && data.keys().hasAll(['name', 'species', 'breed', 'birthDate', 'sex', 'weightKg'])
                 && textBetween('name', 2, 50)
                 && data.species in ['dog', 'cat', 'other']
                 && textBetween('breed', 2, 50)
                 && data.birthDate is string
                 && data.birthDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                 && data.sex in ['male', 'female']
                 && data.weightKg is number && data.weightKg > 0 && data.weightKg <= 150
                 && optionalString('photoUrl', 2048);
        }

        allow read: if isOwner();
        allow create: if isOwner()
                      && isValidPet()
                      && request.resource.data.createdAt == request.time
                      && request.resource.data.updatedAt == request.time;
        allow update: if isOwner()
                      && isValidPet()
                      && unchanged('createdAt')
                      && request.resource.data.updatedAt == request.time;
        allow delete: if isOwner();

        // Registros médicos de la mascota (spec 006): el dueño los lee, crea y borra; no se editan.
        match /records/{recordId} {
          function isValidRecord() {
            let data = request.resource.data;
            return data.keys().hasOnly([
                     'category', 'fileName', 'contentType', 'sizeBytes', 'date', 'type', 'vet', 'createdAt'])
                   && data.keys().hasAll(['category', 'fileName', 'contentType', 'sizeBytes', 'date', 'type', 'createdAt'])
                   && data.category in ['vaccines', 'history', 'files']
                   && data.fileName is string && data.fileName.size() >= 1 && data.fileName.size() <= 120
                   && data.contentType is string
                   && (data.contentType == 'application/pdf' || data.contentType.matches('image/.*'))
                   && data.sizeBytes is int && data.sizeBytes > 0 && data.sizeBytes < 10 * 1024 * 1024
                   && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                   && data.type in ['vaccination', 'consultation', 'exam', 'other']
                   && optionalString('vet', 50)
                   && data.createdAt == request.time;
          }

          allow read: if isOwner();
          allow create: if isOwner() && isValidRecord();
          allow delete: if isOwner();
        }
      }
    }

    // passwordResetCodes (códigos de recuperación hasheados) solo lo usan las Cloud Functions
    // con el Admin SDK: queda denegado para los clientes por la regla de abajo.

    // Todo lo demás queda denegado hasta que una spec lo defina.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
